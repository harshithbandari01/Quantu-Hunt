/* ─────────────────────────────────────────────────────────────────────────────
   TreasureHunt.module.css — Premium Quantum Dashboard
───────────────────────────────────────────────────────────────────────────── */
@keyframes qh-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes qh-fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
@keyframes qh-glow-pulse {
  0%,100% { filter: drop-shadow(0 0 8px rgba(var(--qh-accent-rgb), 0.4)); }
  50% { filter: drop-shadow(0 0 16px rgba(var(--qh-accent-rgb), 0.8)); }
}
@keyframes qh-orbit {
  from { transform: rotate(0deg) translateX(var(--r)) rotate(0deg); }
  to   { transform: rotate(360deg) translateX(var(--r)) rotate(-360deg); }
}
@keyframes qh-dash { to { stroke-dashoffset: -24; } }
@keyframes qh-flash {
  0%   { transform: translate(-50%,-50%) scale(1); opacity: 0.85; }
  100% { transform: translate(-50%,-50%) scale(2.5); opacity: 0; }
}
@keyframes qh-particle {
  0% { offset-distance: 0%; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { offset-distance: 100%; opacity: 0; }
}
/* Referenced by .scannerLine below but never defined, so the scan-line never animated. */
@keyframes qh-scan-line {
  0%   { top: 0; opacity: 0.2; }
  50%  { opacity: 1; }
  100% { top: 100%; opacity: 0.2; }
}
@keyframes qh-pulse-soft {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50%      { opacity: 1; transform: scale(1.06); }
}

.mapPage {
  min-height: 100dvh; background: var(--qh-bg); color: var(--qh-text);
  display: flex; flex-direction: column; overflow-x: hidden;
  font-family: 'Space Grotesk', sans-serif;
}

/* ── Top Bar ─────────────────────────────────────────────────────────────── */
.topBar {
  background: var(--qh-bg-glass); backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--qh-border);
  padding: 1rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;
  z-index: 30; position: sticky; top: 0;
}
.topHeader { display: flex; justify-content: space-between; align-items: center; }
.topTitle {
  font-family: 'Orbitron', monospace; font-size: 1.2rem; font-weight: 700;
  letter-spacing: 0.2em; color: var(--qh-accent); display: flex; align-items: center; gap: 0.5rem;
}
.topSub {
  font-size: 0.65rem; color: var(--qh-muted); letter-spacing: 0.3em; margin-top: 0.2rem;
}

.statsBar {
  display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;
}
.statBlock { display: flex; flex-direction: column; gap: 0.2rem; }
.statLabel { font-family: 'Orbitron', monospace; font-size: 0.55rem; color: var(--qh-faint); letter-spacing: 0.15em; }
.statValue { font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 700; color: var(--qh-text); }

/* ── Dashboard Layout ────────────────────────────────────────────────────── */
.dashboard {
  display: grid; grid-template-columns: 280px 1fr 300px; gap: 1.5rem;
  padding: 1.5rem; flex: 1; max-width: 1800px; margin: 0 auto; width: 100%;
}
@media (max-width: 1024px) {
  .dashboard { grid-template-columns: 1fr; }
}

/* ── Left Column: Mission ────────────────────────────────────────────────── */
.leftCol { display: flex; flex-direction: column; gap: 1.5rem; }
.panel {
  background: var(--qh-surface); border: 1px solid var(--qh-border);
  border-radius: 8px; padding: 1.2rem; backdrop-filter: blur(8px);
}
.panelTitle {
  font-family: 'Orbitron', monospace; font-size: 0.8rem; font-weight: 700;
  letter-spacing: 0.15em; color: var(--qh-accent); margin-bottom: 0.8rem;
  border-bottom: 1px solid var(--qh-border); padding-bottom: 0.5rem;
}
.missionText { font-size: 0.85rem; line-height: 1.6; color: var(--qh-text); }
.missionQuote {
  font-family: 'Orbitron', monospace; font-size: 0.75rem; color: var(--qh-accent2);
  line-height: 1.5; letter-spacing: 0.1em; margin-top: 1rem;
}

/* ── Legend ──────────────────────────────────────────────────────────────── */
.legendItem { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.75rem; color: var(--qh-muted); }
.legendDot { width: 10px; height: 10px; border-radius: 50%; }

/* ── Center Column: Map ──────────────────────────────────────────────────── */
.centerCol {
  position: relative; border-radius: 12px; border: 1px solid var(--qh-border);
  background: var(--qh-surface); overflow: hidden; min-height: 500px;
  display: flex; align-items: center; justify-content: center;
}
.mapSvg { width: 100%; height: 100%; position: absolute; inset: 0; }
.campusBldg { fill: var(--qh-bg); stroke: var(--qh-border); stroke-width: 1.5; opacity: 0.6; }
.campusPath { fill: none; stroke: var(--qh-faint); stroke-width: 2; opacity: 0.2; }
.campusGrass { fill: rgba(16, 185, 129, 0.05); }

/* Map paths */
.qPathBase { fill: none; stroke-width: 2.5; stroke: var(--qh-path-lock); opacity: 0.5; }
.qPathActive { fill: none; stroke-width: 3; stroke-dasharray: 8 6; animation: qh-dash 2s linear infinite; }
.qPathComplete { fill: none; stroke-width: 3; filter: drop-shadow(0 0 4px currentColor); }

/* Map nodes */
.nodeWrap { position: absolute; transform: translate(-50%, -50%); cursor: pointer; z-index: 10; }
.nodeWrap:active { transform: translate(-50%,-50%) scale(0.95); }
.nodeBase {
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--qh-node-bg); border: 2px solid currentColor; transition: all 0.3s;
}
.nodeLocked { opacity: 0.4; border-color: var(--qh-faint); }
.nodeAvailable { border-color: currentColor; box-shadow: 0 0 8px currentColor; }
.nodeCurrent { border-color: currentColor; box-shadow: 0 0 16px currentColor; transform: scale(1.15); }
.nodeCompleted { border-color: currentColor; background: currentColor; box-shadow: 0 0 8px currentColor; }

.nodeLabel {
  position: absolute; top: calc(100% + 6px); left: 50%; transform: translateX(-50%);
  font-family: 'Orbitron', monospace; font-size: 0.45rem; letter-spacing: 0.1em;
  white-space: nowrap; color: var(--qh-text); background: var(--qh-bg-glass);
  padding: 2px 6px; border-radius: 4px; border: 1px solid var(--qh-border); pointer-events: none;
}
.orbitRing { position: absolute; inset: -6px; border: 1px solid currentColor; border-radius: 50%; opacity: 0.5; animation: qh-orbit 4s linear infinite; }
.orbitDot { position: absolute; width: 4px; height: 4px; background: currentColor; border-radius: 50%; top: -2px; left: 50%; transform: translateX(-50%); }

/* ── Right Column: Actions & Progress ────────────────────────────────────── */
.rightCol { display: flex; flex-direction: column; gap: 1.5rem; }

.scanBtn {
  width: 100%; padding: 1.2rem; border-radius: 8px; cursor: pointer;
  background: linear-gradient(135deg, rgba(var(--qh-accent-rgb),0.1), rgba(var(--qh-accent-rgb),0.2));
  border: 1px solid var(--qh-accent); color: var(--qh-accent);
  font-family: 'Orbitron', monospace; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.15em;
  display: flex; align-items: center; justify-content: center; gap: 0.8rem;
  transition: all 0.3s ease; box-shadow: 0 0 15px rgba(var(--qh-accent-rgb), 0.2);
}
.scanBtn:hover { background: rgba(var(--qh-accent-rgb),0.25); box-shadow: 0 0 25px rgba(var(--qh-accent-rgb), 0.4); }

.uploadBtn {
  width: 100%; padding: 0.8rem; border-radius: 8px; cursor: pointer;
  background: var(--qh-bg); border: 1px solid var(--qh-border); color: var(--qh-muted);
  font-family: 'Orbitron', monospace; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em;
  display: flex; align-items: center; justify-content: center; gap: 0.5rem;
  transition: all 0.3s ease;
}
.uploadBtn:hover { color: var(--qh-text); border-color: var(--qh-faint); }

.codeState { margin-bottom: 1rem; }
.codeStateHeader { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
.codeStateLabel { font-family: 'Orbitron', monospace; font-size: 0.6rem; letter-spacing: 0.15em; color: var(--qh-faint); }
.codeStateProgress { font-family: 'Space Grotesk', monospace; font-size: 0.55rem; color: var(--qh-muted); }
.codeDots { display: flex; gap: 4px; }
.codeDot {
  flex: 1; height: 12px; border-radius: 2px; border: 1px solid currentColor;
  transition: all 0.4s ease;
}
.codeDotFilled { background: currentColor; box-shadow: 0 0 8px currentColor; }
.codeDotEmpty { opacity: 0.2; }

/* ── Overlays ────────────────────────────────────────────────────────────── */
.modalOverlay {
  position: fixed; inset: 0; z-index: 50; background: var(--qh-bg-glass);
  backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center;
  padding: 1rem; animation: qh-fade-in 0.2s ease;
}
.modalContent {
  background: var(--qh-surface); border: 1px solid var(--qh-border);
  border-radius: 12px; padding: 2rem; max-width: 500px; width: 100%;
  box-shadow: 0 20px 40px rgba(0,0,0,0.3); display: flex; flex-direction: column; gap: 1.5rem;
}
.closeBtn {
  position: absolute; top: 1rem; right: 1rem; background: none; border: none;
  color: var(--qh-muted); cursor: pointer;
}
.closeBtn:hover { color: var(--qh-text); }

/* Challenge UI */
.challengeTitle { font-family: 'Orbitron', monospace; font-size: 1rem; color: var(--qh-accent); letter-spacing: 0.1em; }
.challengePrompt { font-size: 1rem; line-height: 1.6; color: var(--qh-text); }
.challengeInput {
  width: 100%; background: var(--qh-bg); border: 1px solid var(--qh-border);
  border-radius: 6px; padding: 1rem; color: var(--qh-text); font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem; resize: none; outline: none;
}
.challengeInput:focus { border-color: var(--qh-accent); }
.challengeSubmit {
  padding: 1rem; border-radius: 6px; border: none; background: var(--qh-accent);
  color: var(--qh-btn-fg); font-family: 'Orbitron', monospace; font-size: 0.8rem;
  font-weight: 700; letter-spacing: 0.1em; cursor: pointer;
}
.challengeSubmit:disabled { opacity: 0.5; cursor: not-allowed; }

/*
  Scanner UI.

  Everything below .scannerPage through .detectSub is referenced throughout
  QuantumScanner.tsx but was never actually defined here - the whole header
  (close button, title) and the detection/status text rendered with zero
  layout or styling, run together as plain inline text.
*/
.scannerPage { display: flex; flex-direction: column; gap: 1rem; }

.scannerHeader {
  display: flex; align-items: center; gap: 0.75rem;
}
.backBtn {
  display: flex; align-items: center; gap: 0.35rem;
  background: var(--qh-node-bg); border: 1px solid var(--qh-border);
  color: var(--qh-muted); border-radius: 6px; padding: 0.4rem 0.7rem;
  font-family: 'Orbitron', monospace; font-size: 0.6rem; letter-spacing: 0.1em;
  cursor: pointer; transition: color 0.2s ease, border-color 0.2s ease;
}
.backBtn:hover { color: var(--qh-text); border-color: var(--qh-faint); }
.scannerTitle {
  font-family: 'Orbitron', monospace; font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.15em; color: var(--qh-accent);
}

.scannerBody { display: flex; flex-direction: column; gap: 0.9rem; align-items: center; }
.scannerCanvas { display: none; }

.scannerStatus {
  font-family: 'Orbitron', monospace; font-size: 0.65rem; letter-spacing: 0.12em;
  color: var(--qh-muted); text-align: center;
}
.scannerStatusActive { color: var(--qh-accent); }
.scannerStatusError { color: #dc2626; }

.scannerDetected {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 0.6rem;
  background: rgba(var(--qh-accent-rgb), 0.12); backdrop-filter: blur(2px);
  animation: qh-fade-in 0.2s ease;
}
.detectRing {
  position: absolute; width: 90px; height: 90px; border-radius: 50%;
  border: 2px solid var(--qh-accent); opacity: 0.85;
  animation: qh-flash 1.1s ease-out infinite;
}
.detectText {
  font-family: 'Orbitron', monospace; font-size: 0.8rem; font-weight: 700;
  letter-spacing: 0.1em; color: var(--qh-accent); z-index: 1;
}
.detectSub {
  font-family: 'Space Grotesk', monospace; font-size: 0.65rem;
  letter-spacing: 0.08em; color: var(--qh-muted); z-index: 1;
}

/* Scanner UI */
.scannerViewport { position: relative; width: 100%; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: #000; }
.scannerVideo { width: 100%; height: 100%; object-fit: cover; }
.scannerFrame { position: absolute; inset: 20px; border: 2px solid rgba(var(--qh-accent-rgb), 0.3); }
.scannerCorner { position: absolute; width: 30px; height: 30px; border-color: var(--qh-accent); }
.scannerCorner.tl { top: -2px; left: -2px; border-top: 3px solid; border-left: 3px solid; }
.scannerCorner.tr { top: -2px; right: -2px; border-top: 3px solid; border-right: 3px solid; }
.scannerCorner.bl { bottom: -2px; left: -2px; border-bottom: 3px solid; border-left: 3px solid; }
.scannerCorner.br { bottom: -2px; right: -2px; border-bottom: 3px solid; border-right: 3px solid; }
.scannerLine {
  position: absolute; left: 0; right: 0; height: 2px; background: var(--qh-accent);
  box-shadow: 0 0 10px var(--qh-accent); animation: qh-scan-line 2s linear infinite;
}
.detectOverlay {
  position: absolute; inset: 0; background: rgba(0,0,0,0.8); display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 1rem; animation: qh-fade-in 0.2s;
}

.loadingPulse {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8rem;
  font-family: 'Orbitron', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  color: var(--qh-muted);
  animation: qh-pulse-soft 1.8s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .loadingPulse { animation: none; }
}

/* Final Reveal */
.finalPage {
  position: fixed; inset: 0; z-index: 100; background: var(--qh-bg);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 2rem; animation: qh-fade-in 1s ease;
}
.finalWord {
  font-family: 'Orbitron', monospace; font-size: clamp(1.5rem, 5vw, 3rem); font-weight: 900;
  letter-spacing: 0.2em; border-bottom: 2px solid var(--qh-border); padding-bottom: 0.5rem;
  margin-bottom: 2rem; animation: qh-fade-up 1s ease both;
}
